#!/usr/bin/env python3
{% if dataset_name %}# Dataset: {{ dataset_name }} ({{ dataset_id }})
{% endif %}{% if landing_page %}# Source:  {{ landing_page }}
{% endif %}# Install dependency: uv add requests  (or: pip install requests)

import requests

url = "https://{{ host }}/resource/{{ dataset_id }}.json"
params = {
    "$limit": {{ limit | default(5000) }},{% if select %}
    "$select": "{{ select }}",{% endif %}{% if where %}
    "$where": "{{ where }}",{% endif %}
}
headers = {
    "Accept": "application/json",{% if app_token %}
    "X-App-Token": "{{ app_token }}",{% endif %}
}

response = requests.get(url, params=params, headers=headers, timeout=30)
response.raise_for_status()
records = response.json()

print(f"Retrieved {len(records)} records.")
if records:
    print(records[0])
