{% if dataset_name %}// Dataset: {{ dataset_name }} ({{ dataset_id }})
{% endif %}{% if landing_page %}// Source:  {{ landing_page }}
{% endif %}using System;
using System.Collections.Generic;
using System.Linq;

// Install the package from NuGet first:
// dotnet add package CSM.SodaDotNet
using SODA;

var client = new SodaClient("https://{{ host }}"{% if app_token %}, "{{ app_token }}"{% endif %});

// Get a reference to the resource itself
var dataset = client.GetResource<Dictionary<string, object>>("{{ dataset_id }}");

// Read rows from the dataset
var rows = dataset.GetRows(limit: {{ limit | default(5000) }}).ToList();

Console.WriteLine("Got {0} results. Dumping first result:", rows.Count);
if (rows.Any())
{
    foreach (var keyValue in rows.First())
    {
        Console.WriteLine($"{keyValue.Key}: {keyValue.Value}");
    }
}
